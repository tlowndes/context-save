{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for Context Save's own windows. Local only; no network access.",
  "windows": ["save", "restore", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "notification:default",
    "dialog:allow-open"
  ]
}
