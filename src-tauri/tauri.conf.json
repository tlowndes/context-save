{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context Save",
  "version": "0.1.0",
  "identifier": "uk.co.tomlowndes.contextsave",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "save",
        "url": "index.html?view=save",
        "title": "Save context",
        "width": 560,
        "height": 340,
        "center": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "restore",
        "url": "index.html?view=restore",
        "title": "Restore context",
        "width": 600,
        "height": 520,
        "center": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "settings",
        "url": "index.html?view=settings",
        "title": "Context Save settings",
        "width": 600,
        "height": 560,
        "minWidth": 480,
        "minHeight": 420,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
