{
  "name": "next-step",
  "private": true,
  "version": "0.1.0",
  "description": "Spots the emails you're avoiding and turns each into one tiny next step. Windows tray app for Proton Mail Bridge and Obsidian.",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "bundle": "tauri build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
